{
  "name": "dravencms/user",
  "type": "dravencms-package",
  "description": "User module for dravencms",
  "keywords": [
    "dravencms",
    "user"
  ],
  "license": [
    "LGPL-3.0"
  ],
  "authors": [
    {
      "name": "Adam Schubert"
    }
  ],
  "require": {
    "nette/security": "^3.2.7",
    "dravencms/application": "^0.3",
    "dravencms/database": ">=0.0.3",
    "dravencms/base-form": ">=0.0.1",
    "dravencms/base-grid": "^0.4",
    "dravencms/templated-email": ">=v1.0",
    "dravencms/captcha": ">=0.0.2",
    "dravencms/locale": ">=v1.1.1",
    "php": ">=8.2",
    "doctrine/dbal": "^4.5",
    "doctrine/orm": "^3.5",
    "nette/forms": "^3.3",
    "symfony/console": "^6.4 || ^7.0 || ^8.0"
  },
  "replace": {
    "dravencms/user-light": "*"
  },
  "require-dev": {
    "nette/tester": "@dev"
  },
  "autoload": {
    "psr-0": {
      "Dravencms\\": "src/"
    }
  },
  "extra": {
    "dravencms": {
      "configuration": "dravencms.config.neon"
    }
  },
  "conflict": {
    "dravencms/admin": "<3.2",
    "dravencms/api": "<0.7.0",
    "dravencms/article": "<2.8.0",
    "dravencms/carousel": "<2.5.0",
    "dravencms/cookie-consent": "<1.10.0",
    "dravencms/file": "<2.8.0",
    "dravencms/file-download": "<2.6.0",
    "dravencms/form": "<2.7.0",
    "dravencms/gallery": "<2.7.0",
    "dravencms/locale": "<2.8.0",
    "dravencms/location": "<1.8.0",
    "dravencms/map": "<2.5.0",
    "dravencms/partner": "<2.6.0",
    "dravencms/seo": "<3.8.0",
    "dravencms/structure": "<2.8.0",
    "dravencms/tag": "<2.6.0"
  }
}
