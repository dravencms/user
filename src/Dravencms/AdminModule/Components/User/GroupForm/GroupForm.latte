<form n:name="form" class="card">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="name">{_'user.admin.field.name'}</label>
                    <input type="text" n:name="name" autofocus="autofocus" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="color">{_'user.admin.field.color'}</label>
                    <input type="text" n:name="color" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-12">
                <div class="mb-3">
                    <label class="form-label" n:name="description">{_'user.admin.field.description'}</label>
                    <textarea n:name="description" class="form-control"></textarea>
                </div>
            </div><!-- col-sm-12 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-12">
                <div class="mb-3">
                    <label class="form-label">{_'user.admin.field.permissions'}</label>
                    {include 'permissions.latte', view => $permissionView}
                </div>
            </div><!-- col-sm-12 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" class="form-check-input" n:name="isRegister"> <span class="form-check-label">{_'user.admin.field.registrationDefault'}</span>
                    </label>
                </div> <!-- / .checkbox -->
            </div><!-- col-sm-12 -->
        </div><!-- row -->

    </div>

    <div class="card-footer">
        <input type="submit" n:name="send" class="btn btn-success button" value="{_'user.admin.action.save'}">
    </div>
</form>